@{ Layout = "_Layout"; ViewBag.Titulo = "Excluir contato"; }
@model ExcluirContatoViewModel
<div class="card shadow-sm mx-auto p-4" style="max-width:650px">
<p>Confirma a exclusão do contato <strong>@Model.Nome</strong> (@Model.Email)?</p>
<p class="text-secondary">Contatos vinculados a compromissos não podem ser excluídos.</p>
<form asp-action="Excluir" method="post"><input asp-for="Id" type="hidden"/><div class="d-flex justify-content-end gap-2"><a asp-action="Listar" class="btn btn-outline-secondary">Cancelar</a><button type="submit" class="btn btn-danger">Excluir</button></div></form>
</div>
