@using eAgenda.Dominio.Modulos.Compromissos
@{ Layout = "_Layout"; ViewBag.Titulo = "Editar compromisso"; }
@model EditarCompromissoViewModel
<form class="card shadow-sm mx-auto p-4" style="max-width:760px" asp-action="Editar" method="post">
<input asp-for="Id" type="hidden">
<div class="mb-3"><label asp-for="Assunto" class="form-label">Assunto *</label><input asp-for="Assunto" class="form-control" maxlength="100" required><span asp-validation-for="Assunto" class="text-danger"></span></div>
<div class="row">
<div class="col-md-4 mb-3"><label asp-for="DataOcorrencia" class="form-label">Data *</label><input asp-for="DataOcorrencia" type="date" class="form-control" required><span asp-validation-for="DataOcorrencia" class="text-danger"></span></div>
<div class="col-md-4 mb-3"><label asp-for="HoraInicio" class="form-label">Hora de início *</label><input asp-for="HoraInicio" type="time" class="form-control" required><span asp-validation-for="HoraInicio" class="text-danger"></span></div>
<div class="col-md-4 mb-3"><label asp-for="HoraTermino" class="form-label">Hora de término *</label><input asp-for="HoraTermino" type="time" class="form-control" required><span asp-validation-for="HoraTermino" class="text-danger"></span></div>
</div>
<div class="mb-3"><label asp-for="Tipo" class="form-label">Tipo de compromisso *</label><select asp-for="Tipo" class="form-select" asp-items="Html.GetEnumSelectList<TipoCompromisso>()"></select><span asp-validation-for="Tipo" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="LinkOuLocal" class="form-label">Link (remoto) ou local (presencial) *</label><input asp-for="LinkOuLocal" class="form-control" maxlength="500" required><span asp-validation-for="LinkOuLocal" class="text-danger"></span><div class="form-text">Para remoto, use um endereço http:// ou https://. Para presencial, informe o local.</div></div>
<div class="mb-3"><label asp-for="ContatoId" class="form-label">Contato (opcional)</label><select asp-for="ContatoId" class="form-select" asp-items="ViewBag.Contatos"><option value="">-- Sem contato vinculado --</option></select></div>
@if (TempData["MensagemErro"] is string erro) { <div class="alert alert-danger">@erro</div> }
<div class="d-flex justify-content-end gap-2"><a asp-action="Listar" class="btn btn-outline-secondary">Cancelar</a><button class="btn btn-primary" type="submit">Salvar</button></div>
</form>
